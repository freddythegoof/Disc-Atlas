{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "disc-atlas-auth-fixture",
  "main": "fixtures/auth-worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "vars": {"GOOGLE_CLIENT_ID":"fixture-client","GOOGLE_CLIENT_SECRET":"fixture-secret"},
  "assets": {
    "binding":"ASSETS",
    "directory":"../dist/workers-public",
    "run_worker_first":["/api/*","/auth/*","/signin","/profile","/account-settings"]
  },
  "d1_databases":[{
    "binding":"DB",
    "database_name":"disc-atlas-accounts",
    "database_id":"a30bc57c-7438-4e59-b5d2-732de1b0afb5",
    "migrations_dir":"../migrations/accounts"
  }]
}

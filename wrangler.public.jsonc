{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "disc-atlas-public",
  "main": "workers/public.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node scripts/build-workers.mjs" },
  "assets": {
    "directory": "./dist/workers-public",
    "run_worker_first": ["/api/*", "/signin-with-chatgpt", "/signout-with-chatgpt", "/callback"]
  }
}

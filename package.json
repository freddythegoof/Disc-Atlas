{
  "name": "disc-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:workers": "node scripts/build-workers.mjs",
    "deploy:workers": "wrangler deploy --config wrangler.public.jsonc",
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/check-catalog-rights.mjs && node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:accounts": "node --test tests/auth.mjs",
    "test:accounts:browser": "node tests/accounts-browser.mjs",
    "test:coach": "node --test tests/coach.mjs",
    "test:coach:browser": "node tests/coach-browser.mjs",
    "test:bag": "node --test tests/bag.mjs tests/bag-values.mjs tests/bag-3d-layout.mjs tests/bag-demo.mjs",
    "test:bag:demo": "node tests/bag-demo-browser.mjs",
    "test:bag:browser": "node tests/bag-browser.mjs",
    "test:bag:scene": "node tests/bag-scene-browser.mjs",
    "test:bag:v13": "node tests/bag-v13-browser.mjs",
    "test:bag:3d": "node tests/bag-3d-browser.mjs",
    "test:bag:staging": "node tests/bag-staging-browser.mjs",
    "test:bag:spin": "node tests/bag-spin-pocket-browser.mjs",
    "test:bag:controls": "node tests/bag-map-controls-browser.mjs",
    "test:bag:popup": "node tests/bag-popup-browser.mjs",
    "test:atlas:organic": "node --test tests/atlas-organic.mjs && node tests/atlas-organic-browser.mjs",
    "test:lens:corner": "node tests/lens-corner-browser.mjs",
    "test:atlas:depth": "node --test tests/atlas-depth.mjs && node tests/atlas-depth-browser.mjs",
    "test:directory:layout": "node tests/directory-layout-browser.mjs",
    "test:add-menu": "node tests/add-menu-dismiss-browser.mjs",
    "test:disc3d": "node --test tests/disc3d-shape.mjs && node tests/disc3d-browser.mjs",
    "test:my-map": "node --test tests/personal-lens.mjs tests/personal-map-worker.mjs && node tests/my-map-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
